\@writefile{toc}{\contentsline {section}{\numberline {6}Conclusion}{13}{section.6}\protected@file@percent }
\newlabel{sec:conclusion}{{6}{13}{Conclusion}{section.6}{}}
\@writefile{tdo}{\contentsline {todo}{Summarise your findings. Observations from the analysis tool that may be worth confirming on real images: (1) a dithered image's histogram collapses onto $L$ values per channel, yet it still looks smooth because the tone is carried by the \emph  {density} of the dots; (2) error diffusion preserves the mean brightness almost exactly; (3) pixelising before dithering makes the pattern visible and keeps computation fast.}{13}{section*.25}\protected@file@percent }
